# Пароль комнаты. Тот же самый вы с другом впишете в приложении в поле «пароль».
# Сгенерировать: openssl rand -hex 16
YMSYNC_ROOM_TOKEN=

# --- Только для варианта с TLS (docker compose --profile tls) ---
# Домен, у которого A-запись указывает на IP этой VDS.
#YMSYNC_DOMAIN=music.example.com
# Спрятать голый порт релея, оставив снаружи только Caddy.
#RELAY_PUBLISH=127.0.0.1:8787
# Включать Caddy без --profile tls в каждой команде (и в автообновлении).
#COMPOSE_PROFILES=tls
